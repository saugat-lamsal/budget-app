# Copy to .env and fill in there. .env is git-ignored; this file is not, so
# leave every value here blank.
#
# Plaid keys: Plaid dashboard, Developers > Keys. Use the Sandbox secret only.
# Test bank (sandbox) only until Phase 7.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Seals the bank connection's key in the database (AES-256-GCM): 32 random
# bytes in base64. Make one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The live test-bank tests make a throwaway one of their own each run.
BANK_TOKEN_KEY=
