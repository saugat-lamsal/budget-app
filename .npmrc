save-exact=true

# Packages may not run their own install scripts here. None of ours needs
# one: better-sqlite3 ships compiled copies for every platform, and npm ci
# would otherwise try to compile it from source (it cannot see the package
# saying not to), which fails on machines without a C++ compiler. This
# also keeps a package from running code just by being installed.
# npm test and npm run still run their scripts.
ignore-scripts=true
